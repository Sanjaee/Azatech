# Server Configuration
NODE_ENV=development
PORT=4000

# Database Connection (PostgreSQL / Neon PostgreSQL)
DATABASE_URL=postgresql://azatech:azatech_password@localhost:5432/azatech_oms
DIRECT_DATABASE_URL=postgresql://azatech:azatech_password@localhost:5432/azatech_oms

# JWT Configuration
JWT_SECRET=replace-with-a-strong-random-64-char-secret-in-production
JWT_EXPIRES_IN=8h

# CORS Allowlist (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://azatech-web.vercel.app

# Admin Seeder Credentials (Used only by seed script)
SEED_ADMIN_NAME=Azatech Administrator
SEED_ADMIN_EMAIL=admin@azatech.id
SEED_ADMIN_PASSWORD=Admin@Azatech2026!
